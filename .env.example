# ==============================================================================
# PARTIU MOBILIDADE URBANA & ENTREGAS — VARIÁVEIS DE AMBIENTE SUPABASE
# ==============================================================================
# Instruções:
# 1. Crie o seu projeto no Supabase (https://supabase.com/dashboard)
# 2. Acesse: Project Settings -> API
# 3. Preencha as credenciais abaixo e salve como .env:
# ==============================================================================

# URL base do seu projeto Supabase (Ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
SUPABASE_URL="https://SEU_PROJETO.supabase.co"

# Chave Anônima / Pública (Project Settings -> API -> Project API Keys -> anon / public)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# (Opcional) Project ID gerado pelo Supabase
VITE_SUPABASE_PROJECT_ID="SEU_PROJECT_ID"
SUPABASE_PROJECT_ID="SEU_PROJECT_ID"

# (Opcional) Chave Secreta do Provedor para Edge Functions / Webhooks PSP PIX
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Mapbox Token (para renderização de mapas vetoriais)
VITE_MAPBOX_TOKEN="pk.eyJ1Ijoic2V1LXVzdWFyaW8iLCJhIjoiY2x4eHh4eHh4eHh4In0.xxxxxxxxxxxxxxxxxxxxxx"
MAPBOX_TOKEN="pk.eyJ1Ijoic2V1LXVzdWFyaW8iLCJhIjoiY2x4eHh4eHh4eHh4In0.xxxxxxxxxxxxxxxxxxxxxx"
